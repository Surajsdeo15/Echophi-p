---
import Layout from "../layouts/Layout.astro";
import Ticker from "../components/sections/Ticker.astro";
import Nav from "../components/sections/Nav.astro";
import Hero from "../components/sections/Hero.astro";
import LogoStrip from "../components/sections/LogoStrip.astro";
import Signal from "../components/sections/Signal.astro";
import Channels from "../components/sections/Channels.astro";
import Why from "../components/sections/Why.astro";
import Quality from "../components/sections/Quality.astro";
import UseCases from "../components/sections/UseCases.astro";
import Proof from "../components/sections/Proof.astro";
import Security from "../components/sections/Security.astro";
import Faq from "../components/sections/Faq.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import Footer from "../components/sections/Footer.astro";
import FloatingCta from "../components/sections/FloatingCta.astro";
---

<Layout title="Echophi — Virtual Omnichannel Platform" description="AI-powered voice, WhatsApp, email and SMS platform with human-feedback quality scoring. Automate conversations and maintain quality at scale.">
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Echophi",
      "url": "https://echophi.variphi.com",
      "description": "Virtual omnichannel platform for Voice, WhatsApp, Email and SMS with a human-feedback quality layer.",
      "sameAs": []
    })} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "Echophi",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "description": "AI-powered omnichannel platform with human-feedback quality scoring for voice, WhatsApp, email and SMS."
    })} />
  </Fragment>
  <Ticker />
  <Nav />
  <main>
    <Hero />
    <LogoStrip />
    <Signal />
    <Channels />
    <Why />
    <Quality />
    <UseCases />
    <Proof />
    <Security />
    <Faq />
    <CtaBand />
  </main>
  <Footer />
  <FloatingCta />
</Layout>
