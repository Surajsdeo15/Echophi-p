---
import Layout from "../layouts/Layout.astro";
import Ticker from "../components/sections/Ticker.astro";
import Nav from "../components/sections/Nav.astro";
import Footer from "../components/sections/Footer.astro";
import FloatingCta from "../components/sections/FloatingCta.astro";
import { portalSectionsWithOps } from "../data/api-catalog";
import "../styles/docs.css";

const sections = portalSectionsWithOps();
---

<Layout title="API Reference — Partner REST Endpoints | Echophi" description="Complete REST API reference for the Echophi Partner API. Conversations, agents, webhooks, and more.">
  <Ticker />
  <Nav />
  <main class="docs-shell">
    <div class="container ref-page">
      <header class="ref-page__intro docs-prose">
        <div class="docs-eyebrow">
          <span class="docs-eyebrow__label">API Reference</span>
          <span class="docs-eyebrow__rule" aria-hidden="true"></span>
        </div>
        <h1>API Reference</h1>
        <p>
          Operate-focused Partner contract (v1). Open an operation in the
          <a href="/playground">Playground</a> to try it live.
        </p>
      </header>

      {
        sections.map(({ section, ops }) => (
          <section class="ref-section">
            <h2>{section.title}</h2>
            <p class="ref-section__blurb">{section.blurb}</p>
            <div class="ref-list">
              {ops.map((op) => (
                <a
                  class="ref-item"
                  href={`/playground?op=${encodeURIComponent(op.id)}`}
                >
                  <span class={`method ${op.method.toLowerCase()}`}>{op.method}</span>
                  <span>
                    <div class="ref-item__path">{op.path}</div>
                    <div class="ref-item__summary">{op.summary}</div>
                  </span>
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </main>
  <Footer />
  <FloatingCta href="/#try-it-live" />
</Layout>
