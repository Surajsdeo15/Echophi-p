---
interface Props {
  class?: string;
  style?: string;
}

const { class: className, style } = Astro.props;
---

<span class:list={["crosshair", className]} style={style} aria-hidden="true"></span>

<style>
  .crosshair {
    position: absolute;
    width: 11px;
    height: 11px;
    pointer-events: none;
  }

  .crosshair::before,
  .crosshair::after {
    content: "";
    position: absolute;
    background: var(--line-strong);
  }

  .crosshair::before {
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    transform: translateX(-50%);
  }

  .crosshair::after {
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    transform: translateY(-50%);
  }
</style>
