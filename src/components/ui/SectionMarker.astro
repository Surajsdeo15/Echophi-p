---
interface Props {
  num: string;
  label: string;
  meta?: string;
}

const { num, label, meta } = Astro.props;
---

<div class="section-marker">
  <span class="section-marker__num">{num}</span>
  <span class="section-marker__rule" aria-hidden="true"></span>
  <span class="section-marker__label">{label}</span>
  {
    meta && (
      <>
        <span class="section-marker__rule section-marker__rule--grow" aria-hidden="true"></span>
        <span class="section-marker__meta">{meta}</span>
      </>
    )
  }
  {!meta && <span class="section-marker__rule section-marker__rule--grow" aria-hidden="true"></span>}
</div>

<style>
  .section-marker {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    margin-bottom: var(--sp-7);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .section-marker__num {
    flex-shrink: 0;
    color: var(--text-faint);
  }

  .section-marker__label {
    flex-shrink: 0;
    color: var(--text-dim);
  }

  .section-marker__meta {
    flex-shrink: 0;
    margin-left: auto;
    color: var(--text-faint);
    letter-spacing: 0.06em;
  }

  .section-marker__rule {
    flex-shrink: 0;
    width: 34px;
    height: 1px;
    background: var(--line-strong);
  }

  .section-marker__rule--grow {
    flex: 1;
    width: auto;
    min-width: 24px;
  }
</style>
