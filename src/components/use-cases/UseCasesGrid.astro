---
import UseCasesExplorer from "../../islands/UseCasesExplorer";
import { USE_CASES } from "../../data/use-cases";
---

<section class="uc-main">
  <div class="container">
    <UseCasesExplorer client:load cases={USE_CASES} />
  </div>
</section>

<style>
  .uc-main {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding-block: var(--section-pad);
  }

  /* Filter bar — instrument tags */
  .uc-main :global(.uc-filters) {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    margin-bottom: var(--sp-6);
  }

  .uc-main :global(.uc-filters__pills) {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    width: 100%;
  }

  @media (min-width: 768px) {
    .uc-main :global(.uc-filters) {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-4);
    }

    .uc-main :global(.uc-filters__pills) {
      width: auto;
      flex: 1;
    }
  }

  .uc-main :global(.uc-filters__btn) {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: var(--tap-min);
    padding: 10px 14px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    cursor: pointer;
    transition: color 120ms ease, border-color 120ms ease;
  }

  .uc-main :global(.uc-filters__btn.is-active) {
    border-color: var(--blue);
    color: var(--text);
  }

  .uc-main :global(.uc-filters__active-dot) {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--blue);
    flex-shrink: 0;
  }

  .uc-main :global(.uc-filters__count) {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    white-space: nowrap;
  }

  /* Cards — bordered grid via .bordered-grid on .uc-grid */

  .uc-main :global(.uc-card) {
    padding: var(--sp-5);
    background: transparent;
    opacity: 1;
    transition: opacity 120ms ease;
  }

  .uc-main :global(.uc-card.is-hiding) {
    opacity: 0;
  }

  .uc-main :global(.uc-card__title) {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 700;
    color: var(--text);
  }

  .uc-main :global(.uc-card__tagline) {
    margin: 0 0 10px;
    font-size: 13px;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .uc-main :global(.uc-card__scenario) {
    margin: 0 0 14px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .uc-main :global(.uc-card__metric) {
    display: flex;
    align-items: baseline;
    gap: 8px;
    border-top: 1px solid var(--line);
    padding-top: 12px;
    margin-bottom: 12px;
  }

  .uc-main :global(.uc-card__stat) {
    font-family: var(--font-mono);
    font-size: 18px;
    font-weight: 600;
    color: var(--text-dim);
  }

  .uc-main :global(.uc-card__stat-label) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-faint);
  }

  .uc-main :global(.uc-card__chips) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .uc-main :global(.uc-card__chip) {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: transparent;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }
</style>
