---
import Button from "../ui/Button.astro";
import ThemeToggle from "../ui/ThemeToggle.astro";
import ChannelDot from "../ui/ChannelDot.astro";
import {
  NAV_PRIMARY,
  NAV_DOCUMENT,
  CHANNEL_ORDER,
  CHANNELS,
} from "../../data/home";
import { GOVERN_PARTNER_URL } from "../../data/docs";

const DROPDOWN_LABELS = new Set(["Channels", "Document"]);
const navLinks = NAV_PRIMARY.filter((item) => !DROPDOWN_LABELS.has(item.label));
---

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href="/" aria-label="Echophi home">
      <span class="nav__mark" aria-hidden="true"></span>
      <span class="nav__word">Echophi</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {
        NAV_PRIMARY.map((item, i) => (
          <>
            {i > 0 && <span class="nav__sep" aria-hidden="true">/</span>}
            {item.label === "Channels" ? (
              <div class="nav__dropdown" data-nav-dropdown>
                <button
                  type="button"
                  id="nav-channels-trigger"
                  class="nav__link nav__dropdown-trigger"
                  aria-expanded="false"
                  aria-haspopup="menu"
                  aria-controls="nav-channels-menu"
                  data-nav-dropdown-trigger
                >
                  <span>{item.label}</span>
                  <span class="nav__chevron" aria-hidden="true">▾</span>
                </button>
                <div
                  id="nav-channels-menu"
                  class="nav__menu"
                  role="menu"
                  aria-labelledby="nav-channels-trigger"
                  data-nav-dropdown-menu
                >
                  {CHANNEL_ORDER.map((key, idx) => (
                    <>
                      <a
                        class="nav__menu-item"
                        role="menuitem"
                        href={`/channels/${key}`}
                        tabindex="-1"
                        data-nav-menuitem
                      >
                        <ChannelDot channel={key} />
                        <span class="nav__menu-copy">
                          <span class="nav__menu-name">{CHANNELS[key].label}</span>
                          <span class="nav__menu-sub">
                            Explore {CHANNELS[key].label}
                          </span>
                        </span>
                      </a>
                      {idx < CHANNEL_ORDER.length - 1 && (
                        <div class="nav__menu-divider" role="separator" aria-hidden="true" />
                      )}
                    </>
                  ))}
                </div>
              </div>
            ) : item.label === "Document" ? (
              <div class="nav__dropdown" data-nav-dropdown>
                <button
                  type="button"
                  id="nav-document-trigger"
                  class="nav__link nav__dropdown-trigger"
                  aria-expanded="false"
                  aria-haspopup="menu"
                  aria-controls="nav-document-menu"
                  data-nav-dropdown-trigger
                >
                  <span>{item.label}</span>
                  <span class="nav__chevron" aria-hidden="true">▾</span>
                </button>
                <div
                  id="nav-document-menu"
                  class="nav__menu"
                  role="menu"
                  aria-labelledby="nav-document-trigger"
                  data-nav-dropdown-menu
                >
                  {NAV_DOCUMENT.map((doc, idx) => (
                    <>
                      <a
                        class="nav__menu-item"
                        role="menuitem"
                        href={doc.href}
                        tabindex="-1"
                        data-nav-menuitem
                      >
                        <span class="nav__menu-copy">
                          <span class="nav__menu-name">{doc.label}</span>
                          <span class="nav__menu-sub">{doc.description}</span>
                        </span>
                      </a>
                      {idx < NAV_DOCUMENT.length - 1 && (
                        <div class="nav__menu-divider" role="separator" aria-hidden="true" />
                      )}
                    </>
                  ))}
                  <div class="nav__menu-divider" role="separator" aria-hidden="true" />
                  <div class="nav__menu-cta">
                    <a
                      class="nav__menu-api-key"
                      role="menuitem"
                      href={GOVERN_PARTNER_URL}
                      target="_blank"
                      rel="noreferrer"
                      tabindex="-1"
                      data-nav-menuitem
                    >
                      Get API key
                    </a>
                  </div>
                </div>
              </div>
            ) : (
              <a class="nav__link" href={item.href}>
                {item.label}
              </a>
            )}
          </>
        ))
      }
    </nav>

    <div class="nav__actions">
      <ThemeToggle />
      <button
        type="button"
        class="nav__burger"
        id="nav-drawer-trigger"
        aria-expanded="false"
        aria-controls="nav-drawer"
        aria-label="Open menu"
        data-nav-drawer-trigger
      >
        <span class="nav__burger-lines" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
      <div class="nav__cta">
        <Button variant="solid" href="/#cta">Book a demo</Button>
      </div>
    </div>
  </div>

  <div
    id="nav-drawer"
    class="nav__drawer"
    role="dialog"
    aria-modal="true"
    aria-labelledby="nav-drawer-title"
    aria-hidden="true"
    data-nav-drawer
    inert
  >
    <button
      type="button"
      class="nav__drawer-backdrop"
      tabindex="-1"
      aria-label="Close menu"
      data-nav-drawer-close
    ></button>
    <div class="nav__drawer-panel" data-nav-drawer-panel>
      <div class="nav__drawer-head">
        <p id="nav-drawer-title" class="nav__drawer-label">Menu</p>
        <button
          type="button"
          class="nav__drawer-close"
          aria-label="Close menu"
          data-nav-drawer-close
        >
          <span aria-hidden="true">×</span>
        </button>
      </div>

      <nav class="nav__drawer-nav" aria-label="Mobile">
        <div class="nav__drawer-group">
          <p class="nav__drawer-group-label">Channels</p>
          <ul class="nav__drawer-list">
            {
              CHANNEL_ORDER.map((key) => (
                <li>
                  <a class="nav__drawer-link" href={`/channels/${key}`} data-nav-drawer-link>
                    <ChannelDot channel={key} />
                    <span>{CHANNELS[key].label}</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="nav__drawer-group">
          <p class="nav__drawer-group-label">Document</p>
          <ul class="nav__drawer-list">
            {
              NAV_DOCUMENT.map((doc) => (
                <li>
                  <a class="nav__drawer-link" href={doc.href} data-nav-drawer-link>
                    <span>{doc.label}</span>
                  </a>
                </li>
              ))
            }
            <li>
              <a
                class="nav__drawer-link nav__drawer-api-key"
                href={GOVERN_PARTNER_URL}
                target="_blank"
                rel="noreferrer"
                data-nav-drawer-link
              >
                Get API key
              </a>
            </li>
          </ul>
        </div>

        <ul class="nav__drawer-list">
          {
            navLinks.map((item) => (
              <li>
                <a class="nav__drawer-link nav__drawer-link--plain" href={item.href} data-nav-drawer-link>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>

        <div class="nav__drawer-theme">
          <span class="nav__drawer-theme-label">Theme</span>
          <ThemeToggle />
        </div>
      </nav>

      <div class="nav__drawer-footer">
        <Button variant="solid" href="/#cta" data-nav-drawer-link>
          Book a demo
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  import { MQ } from "../../lib/breakpoints";

  function initNavDropdowns() {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const leaveDelay = reduceMotion ? 0 : 150;

    document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((root) => {
      const trigger = root.querySelector<HTMLButtonElement>("[data-nav-dropdown-trigger]");
      const menu = root.querySelector<HTMLElement>("[data-nav-dropdown-menu]");
      if (!trigger || !menu) return;

      const items = () =>
        [...menu.querySelectorAll<HTMLAnchorElement>("[data-nav-menuitem]")];
      let leaveTimer: ReturnType<typeof setTimeout> | null = null;
      let activeIndex = -1;
      let suppressFocusOpen = false;

      const clearLeaveTimer = () => {
        if (leaveTimer) {
          clearTimeout(leaveTimer);
          leaveTimer = null;
        }
      };

      const focusItem = (index: number) => {
        const list = items();
        if (!list.length) return;
        const next = Math.max(0, Math.min(index, list.length - 1));
        activeIndex = next;
        list.forEach((el, i) => {
          el.tabIndex = i === next ? 0 : -1;
        });
        list[next].focus();
      };

      const close = (returnFocus = false) => {
        clearLeaveTimer();
        trigger.setAttribute("aria-expanded", "false");
        root.classList.remove("is-open");
        activeIndex = -1;
        items().forEach((el) => {
          el.tabIndex = -1;
        });
        if (returnFocus) {
          suppressFocusOpen = true;
          trigger.focus();
          requestAnimationFrame(() => {
            suppressFocusOpen = false;
          });
        }
      };

      const open = () => {
        clearLeaveTimer();
        trigger.setAttribute("aria-expanded", "true");
        root.classList.add("is-open");
      };

      const scheduleClose = () => {
        clearLeaveTimer();
        leaveTimer = setTimeout(() => close(false), leaveDelay);
      };

      trigger.addEventListener("click", (e) => {
        e.stopPropagation();
        const isOpen = root.classList.contains("is-open");
        if (isOpen) close(true);
        else {
          open();
          focusItem(0);
        }
      });

      trigger.addEventListener("focus", () => {
        if (suppressFocusOpen) return;
        open();
      });

      root.addEventListener("mouseenter", () => {
        open();
      });

      root.addEventListener("mouseleave", () => {
        scheduleClose();
      });

      menu.addEventListener("click", (e) => {
        const target = (e.target as HTMLElement).closest<HTMLAnchorElement>("[data-nav-menuitem]");
        if (target) close(false);
      });

      trigger.addEventListener("keydown", (e) => {
        if (e.key === "ArrowDown") {
          e.preventDefault();
          if (!root.classList.contains("is-open")) open();
          focusItem(activeIndex < 0 ? 0 : activeIndex + 1);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          if (!root.classList.contains("is-open")) open();
          focusItem(activeIndex < 0 ? items().length - 1 : activeIndex - 1);
        } else if (e.key === "Escape") {
          close(true);
        }
      });

      menu.addEventListener("keydown", (e) => {
        const list = items();
        if (e.key === "ArrowDown") {
          e.preventDefault();
          focusItem(activeIndex < 0 ? 0 : (activeIndex + 1) % list.length);
        } else if (e.key === "ArrowUp") {
          e.preventDefault();
          focusItem(
            activeIndex < 0
              ? list.length - 1
              : (activeIndex - 1 + list.length) % list.length,
          );
        } else if (e.key === "Escape") {
          e.preventDefault();
          close(true);
        } else if (e.key === "Tab") {
          close(false);
        }
      });

      document.addEventListener("click", (e) => {
        if (!root.contains(e.target as Node)) close(false);
      });

      document.addEventListener("focusin", (e) => {
        if (!root.contains(e.target as Node) && root.classList.contains("is-open")) {
          close(false);
        }
      });
    });
  }

  function initMobileNavDrawer() {
    const drawer = document.querySelector<HTMLElement>("[data-nav-drawer]");
    const trigger = document.querySelector<HTMLButtonElement>("[data-nav-drawer-trigger]");
    const panel = drawer?.querySelector<HTMLElement>("[data-nav-drawer-panel]");
    if (!drawer || !trigger || !panel) return;

    const desktopMq = window.matchMedia(MQ.lgUp);
    let lastFocus: HTMLElement | null = null;

    const focusables = () =>
      [
        ...panel.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
        ),
      ].filter((el) => el.offsetParent !== null || el === panel.querySelector(".nav__drawer-close"));

    const lockScroll = (lock: boolean) => {
      document.documentElement.classList.toggle("nav-drawer-open", lock);
      document.body.style.overflow = lock ? "hidden" : "";
    };

    const close = () => {
      drawer.classList.remove("is-open");
      drawer.setAttribute("aria-hidden", "true");
      drawer.setAttribute("inert", "");
      trigger.setAttribute("aria-expanded", "false");
      trigger.setAttribute("aria-label", "Open menu");
      lockScroll(false);

      if (lastFocus) {
        lastFocus.focus();
        lastFocus = null;
      }
    };

    const open = () => {
      if (desktopMq.matches) return;
      lastFocus = document.activeElement instanceof HTMLElement ? document.activeElement : trigger;
      drawer.classList.add("is-open");
      drawer.setAttribute("aria-hidden", "false");
      drawer.removeAttribute("inert");
      trigger.setAttribute("aria-expanded", "true");
      trigger.setAttribute("aria-label", "Close menu");
      lockScroll(true);

      const first = focusables()[0];
      if (first) first.focus();
    };

    const toggle = () => {
      if (drawer.classList.contains("is-open")) close();
      else open();
    };

    trigger.addEventListener("click", toggle);

    drawer.querySelectorAll("[data-nav-drawer-close]").forEach((el) => {
      el.addEventListener("click", close);
    });

    drawer.querySelectorAll("[data-nav-drawer-link]").forEach((el) => {
      el.addEventListener("click", close);
    });

    drawer.addEventListener("keydown", (e) => {
      if (e.key === "Escape") {
        e.preventDefault();
        close();
        return;
      }

      if (e.key !== "Tab" || !drawer.classList.contains("is-open")) return;

      const list = focusables();
      if (!list.length) return;

      const first = list[0];
      const last = list[list.length - 1];
      const active = document.activeElement;

      if (e.shiftKey && active === first) {
        e.preventDefault();
        last.focus();
      } else if (!e.shiftKey && active === last) {
        e.preventDefault();
        first.focus();
      }
    });

    desktopMq.addEventListener("change", () => {
      if (desktopMq.matches) close();
    });
  }

  initNavDropdowns();
  initMobileNavDrawer();
</script>

<style>
  :global(html.nav-drawer-open) {
    overflow: hidden;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 40;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    overflow: visible;
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-height: 56px;
    overflow: visible;
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    flex-shrink: 0;
    min-width: 0;
  }

  .nav__mark {
    width: 14px;
    height: 14px;
    background: var(--blue);
    border-radius: var(--radius);
    flex-shrink: 0;
  }

  .nav__word {
    font-family: var(--font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--text);
    white-space: nowrap;
  }

  .nav__links {
    display: none;
    align-items: center;
    gap: 10px;
    flex-wrap: nowrap;
    flex-shrink: 1;
    min-width: 0;
    overflow: visible;
  }

  @media (min-width: 1024px) {
    .nav__links {
      display: flex;
    }
  }

  .nav__link {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    padding-block: 6px;
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    transition: color 150ms ease;
    white-space: nowrap;
  }

  .nav__link:hover,
  .nav__dropdown.is-open .nav__dropdown-trigger {
    color: var(--text);
  }

  .nav__sep {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: 12px;
    flex-shrink: 0;
  }

  .nav__dropdown {
    position: relative;
    flex-shrink: 0;
  }

  .nav__dropdown::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 12px;
  }

  .nav__dropdown-trigger {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: var(--tap-min);
    padding-block: 6px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    white-space: nowrap;
  }

  .nav__chevron {
    font-size: 10px;
    line-height: 1;
    color: var(--text-faint);
    transition: transform 150ms ease, color 150ms ease;
  }

  .nav__dropdown.is-open .nav__chevron {
    transform: rotate(180deg);
    color: var(--text);
  }

  .nav__menu {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 60;
    min-width: 220px;
    margin: 0;
    padding: 4px;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.22);
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
    transform: translateY(4px);
    transition:
      opacity 150ms ease,
      transform 150ms ease,
      visibility 150ms ease;
  }

  .nav__dropdown.is-open .nav__menu {
    visibility: visible;
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .nav__menu-item {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    min-height: var(--tap-min);
    padding: 10px 12px;
    border-left: 1px solid transparent;
    border-radius: var(--radius);
    text-decoration: none;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .nav__menu-item:hover,
  .nav__menu-item:focus-visible {
    background: var(--bg);
    border-left-color: var(--blue);
    outline: none;
  }

  .nav__menu-copy {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .nav__menu-name {
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    color: var(--text);
  }

  .nav__menu-sub {
    font-family: var(--font-display);
    font-size: 12px;
    line-height: 1.35;
    color: var(--text-dim);
  }

  .nav__menu-divider {
    height: 1px;
    margin: 0 4px;
    background: var(--line);
  }

  .nav__menu-cta {
    padding: 6px 4px 4px;
  }

  .nav__menu-api-key {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--tap-min);
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
    text-decoration: none;
    transition:
      color 150ms ease,
      border-color 150ms ease,
      background-color 150ms ease;
  }

  .nav__menu-api-key:hover,
  .nav__menu-api-key:focus-visible {
    color: var(--text);
    border-color: var(--blue);
    background: var(--bg);
    outline: none;
  }

  .nav__drawer-api-key {
    justify-content: center;
    margin-top: 6px;
    border: 1px solid var(--line-strong);
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .nav__drawer-api-key:hover,
  .nav__drawer-api-key:focus-visible {
    border-color: var(--blue);
  }

  .nav__actions {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin-left: auto;
  }

  .nav__cta {
    display: none;
  }

  @media (min-width: 1024px) {
    .nav__cta {
      display: inline-flex;
    }

    .nav__actions {
      gap: var(--sp-3);
    }
  }

  .nav__burger {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap-min);
    height: var(--tap-min);
    flex-shrink: 0;
    color: var(--text-dim);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: transparent;
    cursor: pointer;
    transition: color 150ms ease, border-color 150ms ease;
  }

  .nav__burger:hover,
  .nav__burger[aria-expanded="true"] {
    color: var(--text);
    border-color: var(--text-faint);
  }

  @media (min-width: 1024px) {
    .nav__burger {
      display: none;
    }
  }

  .nav__burger-lines {
    display: grid;
    gap: 4px;
    width: 16px;
  }

  .nav__burger-lines span {
    display: block;
    height: 1px;
    background: currentColor;
    transition: transform 150ms ease, opacity 150ms ease;
  }

  .nav__burger[aria-expanded="true"] .nav__burger-lines span:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .nav__burger[aria-expanded="true"] .nav__burger-lines span:nth-child(2) {
    opacity: 0;
  }

  .nav__burger[aria-expanded="true"] .nav__burger-lines span:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  /* —— Mobile drawer —— */
  .nav__drawer {
    position: fixed;
    inset: 0;
    z-index: 50;
    pointer-events: none;
    visibility: hidden;
  }

  .nav__drawer.is-open {
    pointer-events: auto;
    visibility: visible;
  }

  .nav__drawer-backdrop {
    position: absolute;
    inset: 0;
    margin: 0;
    padding: 0;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    cursor: pointer;
    transition: opacity 220ms ease;
  }

  .nav__drawer.is-open .nav__drawer-backdrop {
    opacity: 1;
  }

  .nav__drawer-panel {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    width: min(100%, 360px);
    height: 100%;
    background: var(--bg-elev);
    border-left: 1px solid var(--line);
    transform: translateX(100%);
    transition: transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .nav__drawer.is-open .nav__drawer-panel {
    transform: translateX(0);
  }

  .nav__drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--gutter);
    border-bottom: 1px solid var(--line);
    flex-shrink: 0;
  }

  .nav__drawer-label {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .nav__drawer-close {
