---
import SectionMarker from "../ui/SectionMarker.astro";
import LifecycleSteps from "../ui/LifecycleSteps.astro";
import { LIFECYCLE } from "../../data/home";
---

<section class="quality" id="quality" data-quality-home>
  <div class="container">
    <SectionMarker num="03" label="The quality layer" />
    <div class="quality__intro" data-quality-intro>
      <h2 class="display-lg">One closed loop, running on every conversation</h2>
      <p class="body-copy">
        Steps 4 and 5 are where humans teach the system.
        <a class="quality__link" href="/quality">See the full quality layer →</a>
      </p>
    </div>

    <LifecycleSteps steps={LIFECYCLE} />
  </div>
</section>

<script>
  function initQualityHomeReveal() {
    const section = document.querySelector<HTMLElement>("[data-quality-home]");
    if (!section) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce) {
      section.classList.add("is-ready");
      return;
    }

    const io = new IntersectionObserver(
      (entries) => {
        if (!entries[0]?.isIntersecting) return;
        section.classList.add("is-ready");
        io.disconnect();
      },
      { threshold: 0.18 },
    );
    io.observe(section);
  }

  initQualityHomeReveal();
</script>

<style>
  .quality {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding-block: var(--section-pad);
  }

  .quality__intro {
    margin-bottom: var(--sp-7);
    max-width: 60ch;
    opacity: 0;
    transform: translateY(14px);
  }

  .quality.is-ready .quality__intro {
    animation: quality-intro-in 520ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
  }

  .quality__intro .display-lg {
    margin: 0 0 var(--sp-3);
  }

  .quality__intro .body-copy {
    margin: 0;
  }

  .quality__link {
    color: var(--text-dim);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @keyframes quality-intro-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quality__intro {
      opacity: 1 !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>
