---
import SectionMarker from "../ui/SectionMarker.astro";
import { SECURITY_BADGES, SECURITY_CHECKS } from "../../data/home";
---

<section class="security" id="security">
  <div class="container">
    <SectionMarker
      num="06"
      label="Security & Compliance"
      meta="HIPAA · GDPR · SOC 2 · PCI DSS"
    />

    <div class="security__grid">
      <div>
        <h2 class="display-lg">Enterprise-grade security & compliance</h2>
      </div>

      <div class="security__panel" data-security-panel>
        <div class="security__spotlight" aria-hidden="true"></div>
        <div class="security__badges">
          {
            SECURITY_BADGES.map((b) => (
              <div class="security__badge">
                <span class="security__icon-wrap">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path
                      d={b.iconPath}
                      stroke="currentColor"
                      stroke-width="1.4"
                      stroke-linejoin="round"
                      stroke-linecap="round"
                    />
                  </svg>
                </span>
                <span class="security__badge-label">{b.label}</span>
              </div>
            ))
          }
        </div>

        <div class="security__checks">
          {
            SECURITY_CHECKS.map((c) => (
              <div class="security__check">
                <div class="security__check-main">
                  <span class="security__check-mark" aria-hidden="true">✓</span>
                  <div>
                    <h3 class="security__check-title">{c.title}</h3>
                    <p class="security__check-desc">{c.desc}</p>
                  </div>
                </div>
                <span class="security__tags">{c.tags}</span>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  function initSecuritySpotlight() {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const canHover = window.matchMedia("(hover: hover)").matches;
    if (reduce || !canHover) return;

    document.querySelectorAll<HTMLElement>("[data-security-panel]").forEach((panel) => {
      const onMove = (e: MouseEvent) => {
        const r = panel.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * 100;
        const y = ((e.clientY - r.top) / r.height) * 100;
        panel.style.setProperty("--spot-x", `${x}%`);
        panel.style.setProperty("--spot-y", `${y}%`);
        panel.classList.add("is-spot-active");
      };

      const onLeave = () => {
        panel.classList.remove("is-spot-active");
      };

      panel.addEventListener("mousemove", onMove);
      panel.addEventListener("mouseleave", onLeave);
    });
  }

  initSecuritySpotlight();
</script>

<style>
  .security {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding-block: var(--section-pad);
  }

  .security__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-7);
  }

  @media (min-width: 1024px) {
    .security__grid {
      grid-template-columns: 0.85fr 1.15fr;
      gap: var(--sp-8);
    }
  }

  .security__grid .display-lg {
    margin: 0;
    max-width: 14ch;
  }

  .security__panel {
    --spot-x: 50%;
    --spot-y: 50%;

    position: relative;
    isolation: isolate;
    background: var(--bg-elev);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .security__spotlight {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 280ms ease;
    background: radial-gradient(
      220px circle at var(--spot-x) var(--spot-y),
      var(--blue-dim),
      transparent 70%
    );
  }

  .security__panel.is-spot-active .security__spotlight {
    opacity: 1;
    transition: opacity 120ms ease;
  }

  .security__badges,
  .security__checks {
    position: relative;
    z-index: 1;
  }

  .security__badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(90px, 1fr));
    border-bottom: 1px solid var(--line);
  }

  .security__badge {
    padding: 22px 16px;
    text-align: center;
    border-right: 1px solid var(--line);
  }

  .security__badge:last-child {
    border-right: none;
  }

  .security__icon-wrap {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    color: var(--text-dim);
    margin-bottom: 10px;
  }

  .security__badge-label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-dim);
  }

  .security__checks {
    display: flex;
    flex-direction: column;
  }

  .security__check {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: 18px 20px;
    border-bottom: 1px solid var(--line);
  }

  .security__check:last-child {
    border-bottom: none;
  }

  .security__check-main {
    display: flex;
    gap: 12px;
  }

  .security__check-mark {
    color: var(--blue);
    font-weight: 700;
    line-height: 1.4;
  }

  .security__check-title {
    margin: 0 0 4px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .security__check-desc {
    margin: 0;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--text-dim);
  }

  .security__tags {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  @media (prefers-reduced-motion: reduce) {
    .security__spotlight {
      display: none;
    }
  }

  @media (hover: none) {
    .security__spotlight {
      display: none;
    }
  }
</style>