---
import Button from "../ui/Button.astro";
import { CTA_BAND } from "../../data/home";

interface Props {
  title?: string;
  /** Pass null to omit the supporting line */
  sub?: string | null;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
}

const {
  title = CTA_BAND.title,
  sub = CTA_BAND.sub,
  primaryLabel = CTA_BAND.primaryLabel,
  primaryHref = "/#cta",
  secondaryLabel = CTA_BAND.secondaryLabel,
  secondaryHref = CTA_BAND.secondaryHref,
} = Astro.props;
---

<section class="cta-band" id="cta">
  <div class="container cta-band__inner">
    <h2 class="display-lg">{title}</h2>
    {sub ? <p class="body-copy">{sub}</p> : null}
    <div class="cta-band__actions">
      <Button variant="solid" href={primaryHref}>{primaryLabel}</Button>
      <Button variant="ghost" href={secondaryHref}>{secondaryLabel}</Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--bg-elev);
    border-top: 1px solid var(--line);
  }

  .cta-band__inner {
    text-align: center;
    padding-block: var(--section-pad);
  }

  .cta-band__inner .display-lg {
    margin: 0 auto var(--sp-3);
    max-width: 22ch;
  }

  .cta-band__inner .body-copy {
    margin: 0 auto var(--sp-6);
  }

  .cta-band__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>
