---
import Button from "../ui/Button.astro";
import { CTA_BAND } from "../../data/home";
---

<section class="cta-band" id="cta">
  <div class="container cta-band__inner">
    <h2 class="display-lg">{CTA_BAND.title}</h2>
    <p class="body-copy">{CTA_BAND.sub}</p>
    <div class="cta-band__actions">
      <Button variant="solid" href="#cta">{CTA_BAND.primaryLabel}</Button>
      <Button variant="ghost" href={CTA_BAND.secondaryHref}>{CTA_BAND.secondaryLabel}</Button>
    </div>
  </div>
</section>

<style>
  .cta-band {
    background: var(--bg-elev);
    border-top: 1px solid var(--line);
  }

  .cta-band__inner {
    text-align: center;
    padding-block: var(--sp-8);
  }

  .cta-band__inner .display-lg {
    margin: 0 auto var(--sp-3);
    max-width: 22ch;
  }

  .cta-band__inner .body-copy {
    margin: 0 auto var(--sp-6);
  }

  .cta-band__actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>
