---
import SectionMarker from "../ui/SectionMarker.astro";
import StatRow from "../ui/StatRow.astro";
import { PROOF_STATS } from "../../data/home";
---

<section class="proof" id="proof">
  <div class="container">
    <SectionMarker num="05" label="Proof" />
    <div class="proof__intro">
      <h2 class="display-lg">Results your team can measure</h2>
    </div>
    <StatRow items={PROOF_STATS} />
    <p class="proof__note">Placeholder metrics — no figures are invented.</p>
  </div>
</section>

<style>
  .proof {
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding-block: var(--sp-8);
  }

  .proof__intro {
    margin-bottom: var(--sp-6);
    text-align: left;
  }

  .proof__intro .display-lg {
    margin: 0;
  }

  .proof__note {
    margin: var(--sp-5) 0 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .proof :global(.stat-row__value) {
    color: var(--text-faint);
  }
</style>
